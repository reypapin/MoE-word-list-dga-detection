# ============================================================================
# MODELS DIRECTORY - All models hosted on HuggingFace
# ============================================================================
# Exclude ALL model files and directories from Git
# Models are available at: https://huggingface.co/Reynier/moe-wordlist-dga-models
Models/*/
!Models/README.md

# Specific model file patterns (backup exclusions)
Models/**/*.safetensors
Models/**/*.joblib
Models/**/*.keras
Models/**/*.pth
Models/**/*.pkl
Models/**/*.pickle
Models/**/*.bin
Models/**/*.model
Models/**/*.pt
Models/**/*.ckpt
Models/**/*.h5
Models/**/*.hdf5

# Data files - Allow training data
!train_wl.csv
!Result_csv/*.csv

# Block large data files
**/data/*.csv
**/datasets/*.csv
temp_*.csv

